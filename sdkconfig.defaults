# PSRAM (ESP32-P4 has 64MB Octal SPI PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_INTERNAL_MEMORY_FOR_CACHE=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ESP-Hosted SDIO WiFi Configuration
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=25000
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=4
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=4

# ESP-Hosted: Select C6 as co-processor
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y

# ESP-Hosted: No pre-configured board (custom pin mapping)
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y

# ESP-Hosted: SDIO Slot 1 (flexible GPIO)
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y

# Waveshare ESP32-P4-WIFI6-DEV-KIT SDIO pin mapping (P4 side)
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=14
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=15
CONFIG_ESP_HOSTED_SDIO_PIN_D0=16
CONFIG_ESP_HOSTED_SDIO_PIN_D1=17
CONFIG_ESP_HOSTED_SDIO_PIN_D2=18
CONFIG_ESP_HOSTED_SDIO_PIN_D3=19
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54

# WiFi Remote (ESP-Hosted backend)
CONFIG_ESP_WIFI_REMOTE_ENABLED=y

# WiFi
CONFIG_ESP_WIFI_ENABLED=y

# ESP-SR Speech Recognition Models
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_MN_CN_MULTINET7_QUANT=y

# Other
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
